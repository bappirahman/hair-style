---
import { SITE } from '../lib/site.ts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
	{ href: '/hairstyles', label: 'All hairstyles' },
	{ href: '/popular', label: 'Popular' },
	{ href: '/trending', label: 'Trending' },
	{ href: '/face-shapes', label: 'Face shapes' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-ivory/85 backdrop-blur-md">
	<div class="container-page flex h-16 items-center justify-between gap-4">
		<a href="/" class="group flex items-center gap-2.5 shrink-0">
			<span
				aria-hidden="true"
				class="grid h-8 w-8 place-items-center rounded-full bg-ink text-paper transition-colors group-hover:bg-copper-600"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
					<path d="M12 2c-3.9 0-7 3.1-7 7v2.2c0 .5.4.8.9.8.4 0 .7-.3.8-.7.5-2.6 2.5-4.4 5.3-4.4s4.8 1.8 5.3 4.4c.1.4.4.7.8.7.5 0 .9-.3.9-.8V9c0-3.9-3.1-7-7-7Z"/>
					<path d="M6.2 13.4c-.5 0-.9.4-.8.9.3 3.5 1.4 6 2.5 7.4.3.4.9.2 1-.3.4-2.3.4-4.9-.1-7.2-.1-.5-.5-.8-1-.8H6.2Zm11.6 0h-1.6c-.5 0-.9.3-1 .8-.5 2.3-.5 4.9-.1 7.2.1.5.7.7 1 .3 1.1-1.4 2.2-3.9 2.5-7.4.1-.5-.3-.9-.8-.9Zm-5.8.2c-.6 0-1 .4-1 .9-.2 2.3-.2 4.7 0 7 .1.6 1 .6 1.1 0 .2-2.3.2-4.7 0-7 0-.5-.5-.9-1-.9h.9Z"/>
				</svg>
			</span>
			<span class="font-display text-[1.0625rem] font-semibold tracking-tight">
				{SITE.name}
			</span>
		</a>

		<nav aria-label="Primary" class="hidden md:block">
			<ul class="flex items-center gap-7 text-sm">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class:list={[
									'transition-colors hover:text-copper-600',
									isActive(link.href) ? 'text-copper-700 font-medium' : 'text-stone-700',
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a
			href="/try"
			class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-paper transition-colors hover:bg-copper-600 sm:px-5"
		>
			Try a hairstyle
		</a>
	</div>

	<nav aria-label="Primary mobile" class="md:hidden border-t border-stone-200/70">
		<ul class="container-page flex gap-5 overflow-x-auto py-2.5 text-sm whitespace-nowrap">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? 'page' : undefined}
							class:list={[
								'transition-colors',
								isActive(link.href) ? 'text-copper-700 font-medium' : 'text-stone-600',
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
