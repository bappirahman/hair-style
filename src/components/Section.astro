---
interface Props {
	eyebrow?: string;
	title: string;
	lede?: string;
	href?: string;
	linkLabel?: string;
	as?: 'h2' | 'h3';
	id?: string;
	class?: string;
}
const {
	eyebrow,
	title,
	lede,
	href,
	linkLabel = 'See all',
	as: Heading = 'h2',
	id,
	class: className = '',
} = Astro.props;
---

<section id={id} class={`container-page py-14 sm:py-20 ${className}`}>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<div class="max-w-2xl">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<Heading class="mt-2.5 text-3xl leading-[1.1] sm:text-4xl">{title}</Heading>
			{lede && <p class="mt-3 text-base leading-relaxed text-stone-600">{lede}</p>}
		</div>
		{
			href && (
				<a
					href={href}
					class="shrink-0 border-b border-ink pb-0.5 text-sm font-medium transition-colors hover:border-copper-600 hover:text-copper-600"
				>
					{linkLabel}
				</a>
			)
		}
	</div>
	<div class="mt-8 sm:mt-10">
		<slot />
	</div>
</section>
