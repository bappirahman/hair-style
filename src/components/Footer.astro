---
import { SITE } from '../lib/site.ts';
import { getCategories } from '../lib/catalog.ts';
import { FACE_SHAPES, FACE_SHAPE_LABEL, HAIR_TYPES, HAIR_TYPE_LABEL } from '../lib/taxonomy.ts';

const categories = await getCategories();
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-stone-200 bg-stone-50">
	<div class="container-page py-14">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<div>
				<p class="font-display text-lg">{SITE.name}</p>
				<p class="mt-3 max-w-xs text-sm leading-relaxed text-stone-600">
					Browse 45 hairstyles and preview any of them on your own photo. Everything
					happens in your browser — your photo is never uploaded.
				</p>
				<a
					href="/try"
					class="mt-5 inline-flex rounded-full border border-ink px-4 py-2 text-sm font-medium transition-colors hover:bg-ink hover:text-paper"
				>
					Try a hairstyle
				</a>
			</div>

			<nav aria-labelledby="footer-cat">
				<h2 id="footer-cat" class="eyebrow">Categories</h2>
				<ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-stone-600 sm:grid-cols-1">
					{
						categories.slice(0, 10).map((c) => (
							<li>
								<a href={`/categories/${c.id}`} class="transition-colors hover:text-copper-600">
									{c.data.name}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-labelledby="footer-face">
				<h2 id="footer-face" class="eyebrow">By face shape</h2>
				<ul class="mt-4 space-y-2 text-sm text-stone-600">
					{
						FACE_SHAPES.map((shape) => (
							<li>
								<a href={`/face-shapes/${shape}`} class="transition-colors hover:text-copper-600">
									{FACE_SHAPE_LABEL[shape]} face
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-labelledby="footer-type">
				<h2 id="footer-type" class="eyebrow">By hair type</h2>
				<ul class="mt-4 space-y-2 text-sm text-stone-600">
					{
						HAIR_TYPES.map((type) => (
							<li>
								<a href={`/hair-types/${type}`} class="transition-colors hover:text-copper-600">
									{HAIR_TYPE_LABEL[type]} hair
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div
			class="mt-12 flex flex-col gap-3 border-t border-stone-200 pt-6 text-xs text-stone-500 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} {SITE.name}. Previews are illustrative, not photographic.</p>
			<ul class="flex gap-5">
				<li><a href="/about" class="transition-colors hover:text-copper-600">About</a></li>
				<li><a href="/privacy" class="transition-colors hover:text-copper-600">Privacy</a></li>
				<li><a href="/hairstyles" class="transition-colors hover:text-copper-600">All hairstyles</a></li>
			</ul>
		</div>
	</div>
</footer>
