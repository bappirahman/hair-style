---
import { Image } from 'astro:assets';

import manifest from '../../data/overlay-manifest.json';
import type { Hairstyle } from '../../lib/catalog.ts';
import { hairImage } from '../../lib/images.ts';

interface Props {
	styles: Hairstyle[];
	initialStyle: string;
}
const { styles, initialStyle } = Astro.props;

const anchors = new Map(manifest.map((entry) => [entry.id, entry]));

const tints = [
	{ id: 'natural', label: 'As drawn', swatch: '#5c3d24' },
	{ id: 'jet', label: 'Jet black', swatch: '#171a22' },
	{ id: 'dark-brown', label: 'Dark brown', swatch: '#3a2416' },
	{ id: 'chestnut', label: 'Chestnut', swatch: '#7a4a24' },
	{ id: 'auburn', label: 'Auburn', swatch: '#8c3d1c' },
	{ id: 'blonde', label: 'Blonde', swatch: '#c69b4e' },
	{ id: 'platinum', label: 'Platinum', swatch: '#cfc4ad' },
	{ id: 'grey', label: 'Grey', swatch: '#9c9a97' },
];
---

<div
	class="container-page"
	data-studio-root
	data-initial-style={initialStyle}
>
	<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-8">
		<!-- Stage -->
		<div>
			<div
				class="relative overflow-hidden rounded-card border border-stone-200 bg-stone-100"
				data-studio-dropzone
			>
				<div class="flex flex-col items-center justify-center px-6 py-20 text-center">
					<svg
						viewBox="0 0 24 24"
						class="h-10 w-10 text-stone-400"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V4m0 0L7.5 8.5M12 4l4.5 4.5"/>
						<path stroke-linecap="round" d="M3.5 15v3a2.5 2.5 0 0 0 2.5 2.5h12a2.5 2.5 0 0 0 2.5-2.5v-3"/>
					</svg>
					<p class="mt-4 font-display text-xl">Add your photo</p>
					<p class="mt-2 max-w-sm text-sm leading-relaxed text-stone-600">
						Face the camera, keep your head upright, and make sure both eyes are clearly
						visible. Your photo stays on your device.
					</p>
					<label
						class="mt-6 cursor-pointer rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-copper-600"
					>
						Choose a photo
						<input type="file" accept="image/*" class="sr-only" data-studio-file />
					</label>
					<p class="mt-3 text-2xs text-stone-500">or drop an image here</p>
				</div>
			</div>

			<div class="flex justify-center" data-studio-frame>
				<div
					class="relative mx-auto h-[min(58vh,38rem)] w-auto max-w-full select-none overflow-hidden rounded-card border border-stone-200 bg-stone-900 touch-none"
					data-studio-stage
					hidden
				>
					<!-- Dimensions are replaced with the real ones on load; they are
					     present here so the element never lacks an intrinsic size. -->
					<img
						alt="Your original photo, shown for comparison"
						width="1024"
						height="1280"
						class="absolute inset-0 h-full w-full object-fill"
						data-studio-original
					/>
					<canvas class="absolute inset-0 h-full w-full" data-studio-canvas></canvas>
					<div class="absolute inset-0" data-studio-markers aria-hidden="true"></div>
					<div
						aria-hidden="true"
						class="pointer-events-none absolute inset-y-0 w-px bg-ivory/80 shadow-[0_0_0_1px_rgba(0,0,0,0.25)]"
						style="left: var(--compare, 0%)"
					>
					</div>
				</div>
			</div>

			<p class="mt-3 min-h-5 text-sm text-stone-600" role="status" data-studio-hint></p>

			<div class="mt-4" data-studio-controls hidden>
				<div class="flex flex-wrap items-center gap-2">
					<button
						type="button"
						class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-copper-600"
						data-studio-download
					>
						Download image
					</button>
					<button
						type="button"
						class="rounded-full border border-stone-300 px-4 py-2.5 text-sm transition-colors hover:border-ink"
						data-studio-realign
					>
						Re-align eyes
					</button>
					<button
						type="button"
						class="rounded-full border border-stone-300 px-4 py-2.5 text-sm transition-colors hover:border-ink"
						data-studio-change-photo
					>
						Change photo
					</button>
					<button
						type="button"
						class="rounded-full border border-stone-300 px-4 py-2.5 text-sm transition-colors hover:border-ink"
						data-studio-reset
					>
						Reset fit
					</button>
				</div>

				<label class="mt-5 block">
					<span class="flex items-baseline justify-between">
						<span class="eyebrow">Before / after</span>
						<span class="text-2xs text-stone-500">drag to compare</span>
					</span>
					<input
						type="range"
						min="0"
						max="100"
						value="0"
						class="mt-2 w-full accent-copper-600"
						data-studio-compare
					/>
				</label>
			</div>
		</div>

		<!-- Controls -->
		<aside
			class="rounded-card border border-stone-200 bg-paper p-5 lg:sticky lg:top-24 lg:self-start"
			data-studio-controls
			hidden
			aria-label="Fit and colour controls"
		>
			<p class="eyebrow">Now trying</p>
			<p class="mt-1.5 font-display text-xl" data-studio-style-label>&mdash;</p>

			<div class="mt-6 space-y-5">
				<label class="block">
					<span class="flex items-baseline justify-between"><span class="eyebrow">Size</span><output class="text-2xs tabular-nums text-stone-500" data-studio-out-size></output></span>
					<input
						type="range"
						min="40"
						max="250"
						value="100"
						class="mt-2 w-full accent-copper-600"
						data-studio-size
					/>
				</label>
				<label class="block">
					<span class="flex items-baseline justify-between"><span class="eyebrow">Rotation</span><output class="text-2xs tabular-nums text-stone-500" data-studio-out-rotate></output></span>
					<input
						type="range"
						min="-30"
						max="30"
						value="0"
						class="mt-2 w-full accent-copper-600"
						data-studio-rotate
					/>
				</label>
				<label class="block">
					<span class="flex items-baseline justify-between"><span class="eyebrow">Up / down</span><output class="text-2xs tabular-nums text-stone-500" data-studio-out-nudge></output></span>
					<input
						type="range"
						min="-200"
						max="200"
						value="0"
						class="mt-2 w-full accent-copper-600"
						data-studio-nudge
					/>
				</label>
				<label class="block">
					<span class="flex items-baseline justify-between"><span class="eyebrow">Opacity</span><output class="text-2xs tabular-nums text-stone-500" data-studio-out-opacity></output></span>
					<input
						type="range"
						min="30"
						max="100"
						value="100"
						class="mt-2 w-full accent-copper-600"
						data-studio-opacity
					/>
				</label>
				<button
					type="button"
					aria-pressed="false"
					class="w-full rounded-full border border-stone-300 px-4 py-2.5 text-sm transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper"
					data-studio-flip
				>
					Mirror horizontally
				</button>
			</div>

			<div class="mt-6 border-t border-stone-200 pt-5">
				<p class="eyebrow">Hair colour</p>
				<div class="mt-3 flex flex-wrap gap-2">
					{
						tints.map((t, i) => (
							<button
								type="button"
								data-studio-tint
								data-tint={t.id}
								data-active={i === 0 ? 'true' : 'false'}
								aria-pressed={i === 0}
								title={t.label}
								class="h-8 w-8 rounded-full border-2 border-stone-200 transition-[border-color,transform] hover:scale-110 data-[active=true]:border-ink"
								style={`background:${t.swatch}`}
							>
								<span class="sr-only">{t.label}</span>
							</button>
						))
					}
				</div>
			</div>
		</aside>
	</div>

	<!-- Style rail -->
	<section class="mt-8" data-studio-rail hidden aria-label="Choose a hairstyle">
		<h2 class="eyebrow">Swap hairstyle &mdash; the fit is kept</h2>
		<ul
			role="list"
			class="mt-3 flex gap-3 overflow-x-auto pb-3 [scrollbar-width:thin]"
		>
			{
				styles.map((style) => {
					const entry = anchors.get(style.data.overlay);
					if (!entry) return null;
					return (
						<li class="shrink-0">
							<button
								type="button"
								data-studio-style
								data-id={style.id}
								data-name={style.data.name}
								data-src={`/overlays/${style.data.overlay}-1024.webp`}
								data-lx={entry.leftEye[0]}
								data-ly={entry.leftEye[1]}
								data-rx={entry.rightEye[0]}
								data-ry={entry.rightEye[1]}
								data-active="false"
								aria-pressed="false"
								class="group block w-24 overflow-hidden rounded-lg border-2 border-transparent bg-paper text-left transition-colors data-[active=true]:border-ink"
							>
								<Image
									src={hairImage(style.data.overlay)}
									alt=""
									widths={[192]}
									sizes="6rem"
									loading="lazy"
									decoding="async"
									class="aspect-4/5 w-full object-cover"
								/>
								<span class="block px-1.5 py-1.5 text-[0.6875rem] leading-tight text-stone-600 group-data-[active=true]:text-ink">
									{style.data.shortName ?? style.data.name}
								</span>
							</button>
						</li>
					);
				})
			}
		</ul>
	</section>

	<!-- Reference image -->
	<section
		class="mt-10 rounded-card border border-stone-200 bg-stone-50 p-5 sm:p-6"
		aria-labelledby="reference-heading"
		data-studio-ref-panel
	>
		<h2 id="reference-heading" class="font-display text-xl">Use your own hairstyle image</h2>
		<p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-600">
			Have a photo of a cut you want to try? Load it here and knock out its background with
			the threshold slider, then apply it over your photo and position it by hand. This is a
			threshold and a blur, not automatic cut-out &mdash; so a{' '}
			<strong>front-facing image on a plain, light background</strong> works far better than a
			busy one, and a transparent PNG works best of all.
		</p>

		<div class="mt-5 grid gap-5 sm:grid-cols-[14rem_1fr]">
			<div>
				<div
					class="grid aspect-4/5 place-items-center overflow-hidden rounded-lg border border-stone-200 bg-[repeating-conic-gradient(#e2ddd3_0_25%,#f7f5f1_0_50%)] bg-[length:16px_16px]"
				>
					<canvas class="max-h-full max-w-full object-contain" data-studio-ref-preview></canvas>
				</div>
				<label
					class="mt-3 flex cursor-pointer justify-center rounded-full border border-stone-300 px-4 py-2.5 text-sm transition-colors hover:border-ink"
				>
					Choose a hairstyle image
					<input type="file" accept="image/*" class="sr-only" data-studio-ref-file />
				</label>
			</div>

			<div class="space-y-5">
				<label class="block">
					<span class="eyebrow">Remove background above brightness</span>
					<input
						type="range"
						min="30"
						max="100"
						value="100"
						class="mt-2 w-full accent-copper-600"
						data-studio-ref-threshold
					/>
					<span class="mt-1 block text-2xs text-stone-500">
						Slide left to cut away lighter pixels. At 100 nothing is removed.
					</span>
				</label>
				<label class="block">
					<span class="eyebrow">Feather edge</span>
					<input
						type="range"
						min="0"
						max="12"
						value="2"
						class="mt-2 w-full accent-copper-600"
						data-studio-ref-feather
					/>
					<span class="mt-1 block text-2xs text-stone-500">
						Softens the cut edge so it blends rather than showing a hard outline.
					</span>
				</label>
				<button
					type="button"
					disabled
					class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-copper-600 disabled:cursor-not-allowed disabled:bg-stone-300"
					data-studio-ref-apply
				>
					Use this over my photo
				</button>
				<p class="text-2xs text-stone-500">
					Add your photo above first. Once applied, drag, scale and rotate it into place with
					the controls — a reference image has no eye anchors, so it cannot be fitted
					automatically.
				</p>
			</div>
		</div>
	</section>
</div>

<script>
	import { initStudio } from './studio.ts';

	const root = document.querySelector<HTMLElement>('[data-studio-root]');
	if (root) initStudio(root);
</script>
