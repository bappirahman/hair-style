---
import HairstyleGrid from '../components/HairstyleGrid.astro';
import Seo from '../components/Seo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { popular } from '../lib/catalog.ts';

const styles = await popular(4);
---

<BaseLayout>
	<Seo
		slot="head"
		title="Page not found"
		description="That page does not exist. Browse the hairstyle catalogue instead."
		path="/404"
		noindex
	/>

	<section class="container-page py-20 text-center">
		<p class="eyebrow">404</p>
		<h1 class="mt-3 text-4xl leading-[1.05] sm:text-5xl">That page grew out</h1>
		<p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-stone-600">
			The page you were looking for isn't here. The catalogue is, though — 45 hairstyles, all
			of them ready to try on your photo.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a
				href="/hairstyles"
				class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-copper-600"
			>
				Browse all hairstyles
			</a>
			<a
				href="/try"
				class="rounded-full border border-stone-300 px-6 py-3 text-sm font-medium transition-colors hover:border-ink"
			>
				Open the studio
			</a>
		</div>
	</section>

	<section aria-labelledby="popular-404" class="container-page pb-16">
		<h2 id="popular-404" class="font-display text-2xl">Popular right now</h2>
		<div class="mt-6"><HairstyleGrid styles={styles} /></div>
	</section>
</BaseLayout>
