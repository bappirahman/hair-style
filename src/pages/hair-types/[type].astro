---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HairstyleGrid from '../../components/HairstyleGrid.astro';
import Seo from '../../components/Seo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byHairType } from '../../lib/catalog.ts';
import { HAIR_TYPE_CONTENT } from '../../lib/facets.ts';
import { hairImage } from '../../lib/images.ts';
import { breadcrumbSchema, graph, itemListSchema, type Crumb } from '../../lib/schema.ts';
import { HAIR_TYPES, type HairType } from '../../lib/taxonomy.ts';

export function getStaticPaths() {
	return HAIR_TYPES.map((type) => ({ params: { type } }));
}

const type = Astro.params.type as HairType;
const facet = HAIR_TYPE_CONTENT[type];
const styles = await byHairType(type);
const path = `/hair-types/${type}`;

const crumbs: Crumb[] = [
	{ name: 'Home', href: '/' },
	{ name: 'Hair types', href: '/hair-types' },
	{ name: facet.title, href: path },
];
---

<BaseLayout>
	<Seo
		slot="head"
		title={facet.seoTitle}
		description={facet.seoDescription}
		path={path}
		image={styles[0] ? hairImage(styles[0].data.overlay).src : undefined}
		imageAlt={styles[0]?.data.imageAlt}
	>
		<script
			type="application/ld+json"
			is:inline
			set:html={graph(
				breadcrumbSchema(crumbs),
				itemListSchema(
					styles.map((s) => ({
						name: s.data.name,
						href: `/hairstyles/${s.id}`,
						image: hairImage(s.data.overlay).src,
					})),
					facet.seoTitle,
				),
			)}
		/>
	</Seo>

	<div class="container-page pt-6">
		<Breadcrumbs crumbs={crumbs} />
	</div>

	<header class="container-page pt-6">
		<p class="eyebrow">Hair type</p>
		<h1 class="mt-2.5 max-w-3xl text-4xl leading-[1.05] sm:text-5xl">
			Best hairstyles for {facet.title.toLowerCase()}
		</h1>
		<p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">{facet.tagline}</p>
	</header>

	<div class="container-page grid gap-10 py-10 lg:grid-cols-[1fr_20rem]">
		<div class="editorial">
			{facet.body.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<aside class="rounded-card border border-stone-200 bg-stone-50 p-6 lg:sticky lg:top-24 lg:self-start">
			<h2 class="eyebrow">The short version</h2>
			<ul class="mt-4 space-y-3 text-sm leading-relaxed text-stone-700">
				{
					facet.rules.map((rule) => (
						<li class="flex gap-2.5">
							<span aria-hidden="true" class="mt-2 h-1 w-1 shrink-0 rounded-full bg-copper-500" />
							<span>{rule}</span>
						</li>
					))
				}
			</ul>
		</aside>
	</div>

	<section aria-labelledby="matches" class="container-page pb-16">
		<h2 id="matches" class="font-display text-2xl">
			{styles.length} hairstyles that suit {facet.title.toLowerCase()}
		</h2>
		<div class="mt-6">
			<HairstyleGrid styles={styles} />
		</div>
	</section>
</BaseLayout>
