---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Seo from '../../components/Seo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { facetCounts, getCategories } from '../../lib/catalog.ts';
import { breadcrumbSchema, graph, itemListSchema, type Crumb } from '../../lib/schema.ts';

const categories = await getCategories();
const counts = await facetCounts();
const crumbs: Crumb[] = [
	{ name: 'Home', href: '/' },
	{ name: 'Categories', href: '/categories' },
];
---

<BaseLayout>
	<Seo
		slot="head"
		title="Hairstyle Categories — Fades, Tapers, Crops and More"
		description="Browse hairstyles by category: fades, tapers, buzz cuts, crops, undercuts, pompadours, quiffs, curtains, curly, wavy and long hair."
		path="/categories"
	>
		<script
			type="application/ld+json"
			is:inline
			set:html={graph(
				breadcrumbSchema(crumbs),
				itemListSchema(
					categories.map((c) => ({ name: c.data.name, href: `/categories/${c.id}` })),
					'Hairstyle categories',
				),
			)}
		/>
	</Seo>

	<div class="container-page pt-6"><Breadcrumbs crumbs={crumbs} /></div>

	<header class="container-page pt-6">
		<p class="eyebrow">Browse by shape</p>
		<h1 class="mt-2.5 max-w-3xl text-4xl leading-[1.05] sm:text-5xl">Hairstyle categories</h1>
		<p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-600">
			Fifteen families of cut, each with its own logic. If you know roughly what you want but
			not exactly which version, start here.
		</p>
	</header>

	<ul role="list" class="container-page grid gap-4 py-10 pb-16 sm:grid-cols-2 lg:grid-cols-3">
		{
			categories.map((category) => (
				<li>
					<a
						href={`/categories/${category.id}`}
						class="group flex h-full flex-col rounded-card border border-stone-200 bg-paper p-6 shadow-lift transition-[transform,box-shadow] duration-300 ease-out-soft hover:-translate-y-0.5 hover:shadow-lift-lg"
					>
						<h2 class="font-display text-xl transition-colors group-hover:text-copper-700">
							{category.data.name}
						</h2>
						<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
							{category.data.tagline}
						</p>
						<p class="mt-4 text-2xs text-stone-500">
							{counts.categories.get(category.id as never) ?? 0} hairstyles
						</p>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
